# Copy to .env. Placeholders only; never commit real values.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
FAKE_PLATFORM_URL=http://fake-platform:9000
# base64 of 32 random bytes; `make env` fills it. Leave empty here.
TOKEN_ENCRYPTION_KEY=
# OAuth client for the fake platform (any non-empty values work against it)
FAKE_CLIENT_ID=dev-client
FAKE_CLIENT_SECRET=changeme-placeholder
WEBHOOK_SECRET=changeme-placeholder
WEBHOOK_URL=http://api:8000/webhook/social-delivery
# Caption generation: "none" = templates only; "gemini" calls the REST API (key placeholder only)
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=10
